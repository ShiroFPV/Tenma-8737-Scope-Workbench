{
  "name": "tenma-scope-studio",
  "version": "1.0.0",
  "description": "ShiroFPV Desktop Workbench for Tenma 8737 & 72-87XX Digital Storage Oscilloscopes",
  "main": "main.js",
  "author": "ShiroFPV",
  "license": "MIT",
  "build": {
    "appId": "com.shirofpv.tenmascope",
    "productName": "TenmaScopeStudio",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tenma Scope Workbench",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "serial-bridge.exe",
      "tenma_bridge.exe",
      "public/**/*",
      "tenma_scope_api.py"
    ]
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.7.0"
  }
}
